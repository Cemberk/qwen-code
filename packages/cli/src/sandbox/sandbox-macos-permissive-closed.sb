(version 1)

;; allow everything by default
(allow default)

;; deny all writes EXCEPT under specific paths
(deny file-write*)
(allow file-write*
    (subpath (param "TARGET_DIR"))
    (subpath (param "TMP_DIR"))
    (subpath (param "CACHE_DIR"))
    (subpath (param "QWEN_DIR"))
    (subpath (param "RUNTIME_DIR"))
    (subpath (string-append (param "HOME_DIR") "/.npm"))
    (subpath (string-append (param "HOME_DIR") "/.cache"))
    ;; Allow writes to included directories from --include-directories
    (subpath (param "INCLUDE_DIR_0"))
    (subpath (param "INCLUDE_DIR_1"))
    (subpath (param "INCLUDE_DIR_2"))
    (subpath (param "INCLUDE_DIR_3"))
    (subpath (param "INCLUDE_DIR_4"))
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/null")
)

;; The CLI loads and runs what these hold (hooks, MCP servers, extensions,
;; environment, trust and approval decisions), also when it later runs
;; outside the sandbox, so nothing inside the sandbox may change them. The
;; extension store's bookkeeping (extension-store/) stays writable: the CLI
;; locks and updates it on every start, and it can only switch extensions
;; already installed under extensions/ on or off.
(deny file-write*
    (literal (string-append (param "QWEN_DIR") "/settings.json"))
    (literal (string-append (param "QWEN_DIR") "/.env"))
    (literal (string-append (param "QWEN_DIR") "/trustedFolders.json"))
    (literal (string-append (param "QWEN_DIR") "/mcpApprovals.json"))
    (literal (string-append (param "QWEN_DIR") "/extension-secrets-v1.json"))
    (subpath (string-append (param "QWEN_DIR") "/extensions"))
    (subpath (string-append (param "QWEN_DIR") "/skills"))
    (subpath (string-append (param "QWEN_DIR") "/agents"))
    (subpath (string-append (param "QWEN_DIR") "/commands"))
    (subpath (string-append (param "QWEN_DIR") "/workflows"))
    (subpath (string-append (param "QWEN_DIR") "/rules"))
    (subpath (string-append (param "QWEN_DIR") "/output-styles"))
)

;; Network: this machine only. Seatbelt's `localhost` matches the machine's
;; own addresses, so outbound connections reach the local model server and
;; other local services but never leave the machine; every other
;; destination, DNS included, is refused. Nothing listens except the
;; debugger port.
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind (local ip "localhost:9229"))
(allow network-inbound (local ip "localhost:9229"))
