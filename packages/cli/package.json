{
  "name": "@qwen-code/qwen-code",
  "private": true,
  "version": "0.24.6",
  "description": "Qwen Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/qwen-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qwen": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "start": "node dist/index.js",
    "debug": "node --inspect-brk dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-i18n": "tsx ../../scripts/check-i18n.ts"
  },
  "files": [
    "dist"
  ],
  "config": {
    "sandboxImageUri": "qwen-code-sandbox:0.24.6"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@qwen-code/qwen-code-core": "file:../core",
    "@qwen-code/web-templates": "file:../web-templates",
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.2.2",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "command-exists": "^1.2.9",
    "diff": "^7.0.0",
    "dotenv": "^17.1.0",
    "fast-deep-equal": "^3.1.3",
    "fzf": "^0.5.2",
    "glob": "^10.5.0",
    "ink": "7.0.3",
    "ink-gradient": "^3.0.0",
    "ink-link": "^4.1.0",
    "ink-spinner": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "lowlight": "^3.3.0",
    "p-limit": "^7.3.0",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "punycode": "^2.3.1",
    "react": "^19.2.4",
    "read-package-up": "^11.0.0",
    "remend": "^1.3.1",
    "shell-quote": "^1.9.0",
    "string-width": "^7.1.0",
    "strip-ansi": "^7.1.0",
    "strip-json-comments": "^3.1.1",
    "unified": "^11.0.0",
    "wrap-ansi": "^10.0.0",
    "yaml": "^2.8.1",
    "yargs": "^17.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@google/genai": "2.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/command-exists": "^1.2.3",
    "@types/diff": "^7.0.2",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/shell-quote": "^1.7.5",
    "@types/yargs": "^17.0.32",
    "archiver": "^7.0.1",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^26.1.0",
    "react-dom": "^19.1.0",
    "remend": "^1.3.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
