{
  "name": "@qwen-code/qwen-code-core",
  "private": true,
  "version": "0.24.6",
  "description": "Qwen Code Core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/qwen-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transcriptRecords": {
      "types": "./dist/src/utils/transcript-records.d.ts",
      "import": "./dist/src/utils/transcript-records.js"
    },
    "./envVarResolver": {
      "types": "./dist/src/utils/envVarResolver.d.ts",
      "import": "./dist/src/utils/envVarResolver.js"
    },
    "./goalWire": {
      "types": "./dist/src/goals/goal-wire.d.ts",
      "import": "./dist/src/goals/goal-wire.js"
    },
    "./board": {
      "types": "./dist/src/board.d.ts",
      "import": "./dist/src/board.js"
    },
    "./storage": {
      "types": "./dist/src/config/storage.d.ts",
      "import": "./dist/src/config/storage.js"
    },
    "./atomicFileWrite": {
      "types": "./dist/src/utils/atomicFileWrite.d.ts",
      "import": "./dist/src/utils/atomicFileWrite.js"
    },
    "./debugLogger": {
      "types": "./dist/src/utils/debugLogger.d.ts",
      "import": "./dist/src/utils/debugLogger.js"
    },
    "./package.json": "./package.json",
    "./*": "./dist/src/*",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./shellResult": {
      "types": "./dist/src/utils/shell-result.d.ts",
      "import": "./dist/src/utils/shell-result.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js"
  },
  "files": [
    "dist",
    "vendor",
    "scripts/postinstall.js"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@xterm/headless": "5.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.0",
    "async-mutex": "^0.5.0",
    "chardet": "^2.1.0",
    "chokidar": "^4.0.3",
    "diff": "^7.0.0",
    "dotenv": "^17.1.0",
    "fast-levenshtein": "^2.0.6",
    "fzf": "^0.5.2",
    "glob": "^10.5.0",
    "iconv-lite": "^0.6.3",
    "ignore": "^7.0.0",
    "jsonrepair": "^3.13.0",
    "marked": "^15.0.12",
    "mime": "4.0.7",
    "openai": "5.11.0",
    "picomatch": "^4.0.1",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "^0.35.4",
    "shell-quote": "^1.9.0",
    "simple-git": "^3.36.0",
    "strip-ansi": "^7.1.0",
    "tar": "^7.5.19",
    "undici": "^7.28.0",
    "uuid": "^9.0.1",
    "web-tree-sitter": "^0.24.7",
    "yaml": "^2.8.1",
    "yauzl": "^2.10.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10"
  },
  "devDependencies": {
    "@google/genai": "2.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/diff": "^7.0.2",
    "@types/dotenv": "^6.1.1",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "20.19.1",
    "@types/picomatch": "^4.0.1",
    "@types/prompts": "^2.4.9",
    "@types/tar": "^6.1.13",
    "@types/yauzl": "^2.9.1",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
